# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/

# Node / AGH
node_modules/
packages/

# Run instances (per-run artifacts, never committed)
runs/

# Generated audit pack (deliverable output; template stays tracked)
audit-pack/
audit-pack.tar.gz

# Secrets & env
.env
*.key
*.secret

# Evidence exports
# 原始 daemon 导出含本机绝对路径，不入 git（打包时从磁盘归集）。
# 注：此前的 evidence/agh-session-sanitized.jsonl 因使用**非 AGH 真实信封**的
# 自造结构而移除（见 evidence/AGH-真实会话落地报告.md）；真实证据改为在
# 打包阶段用 `agnes export <SESSION_ID> --format agnes` 归集。
evidence/*.jsonl

# OS
.DS_Store
Thumbs.db

# Workdir scratch
workdir/
workdir_*.json  
workdir_*.err  
